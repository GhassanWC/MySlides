# Copy to .env and fill with your Firebase project config (Console > Project settings > General > Your apps).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: use Firebase emulators for local dev (run: firebase emulators:start --only auth,firestore,functions)
# VITE_USE_FIREBASE_EMULATORS=true
